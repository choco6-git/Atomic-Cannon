{
  "name": "atomic-cannon",
  "version": "3.1.6",
  "description": "Atomic Cannon - Web port of classic turn-based tank combat game",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "homepage": "https://github.com/ppizarror/Atomic-Cannon",
  "repository": {
    "type": "git",
    "url": "https://github.com/ppizarror/Atomic-Cannon"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "vite build",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "deploy:net": "wrangler deploy",
    "dev": "vite",
    "dev:net": "wrangler dev",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"worker/**/*.ts\" \"test/**/*.ts\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"worker/**/*.ts\" \"test/**/*.ts\" \"*.{json,ts}\"",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@preact/signals": "^2.11.1",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.20.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.2.0",
    "oxlint": "^1.79.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
